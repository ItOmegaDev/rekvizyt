# Приклад конфігурації. Скопіюйте у .env і заповніть.
NODE_ENV=development
PORT=4000
DATA_DIR=.data
# Client ID з Google Cloud Console (тип "Web application"). Без нього працює лише DEV_LOGIN.
GOOGLE_CLIENT_ID=
# Дозволені email через кому. У production обов'язковий.
ALLOWED_EMAILS=
# Мінімум 32 символи. У production обов'язковий.
SESSION_SECRET=
# Локальний вхід без Google. Тільки для розробки, у production має бути 0.
DEV_LOGIN=1
# Origin фронтенду (для CORS/CSRF). Через кому.
CLIENT_ORIGIN=http://localhost:5173
# Чи віддавати зібраний client/dist самим сервером.
SERVE_CLIENT=1
